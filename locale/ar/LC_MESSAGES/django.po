#: .\management_system\templates\promotion_evaluation.html:26
#, python-format
#| msgid ""
#| "Configure the promotion evaluation formula for an academic year and "
#| "level. Set the overall passing threshold and evaluation date, then define "
#| "weighted rules for quizzes or attendance. Each rule's weight determines "
#| "its contribution to the final score; for a single rule, a blank weight is "
#| "normalized to 100%%. Every applicable rule must meet its minimum pass "
#| "threshold, and the weighted score must also meet the overall pass "
#| "threshold."
msgid ""
"Configure the promotion evaluation formula for an academic year and level. "
"Set the overall passing threshold, evaluation start/end dates, and the "
"failed-course repeat threshold, then define weighted rules for quizzes or "
"attendance. Each rule's weight determines its contribution to the final "
"score; for a single rule, a blank weight is normalized to 100%%. Every "
"applicable rule must meet its minimum pass threshold, and the weighted score "
"must also meet the overall pass threshold. A course-specific formula "
"overrides the all-courses formula for that offering."
msgstr ""
"اضبط صيغة تقييم الترقية للسنة الدراسية والمستوى. حدّد نسبة النجاح الإجمالية "
"وتاريخي بدء وانتهاء التقييم وحد إعادة المقررات الراسبة، ثم عرّف قواعد موزونة "
"للاختبارات أو الحضور. يحدد وزن كل قاعدة "
"مساهمتها في النتيجة النهائية؛ وعند وجود قاعدة واحدة يُطبّع الوزن الفارغ إلى "
"100%%. يجب أن تحقق كل قاعدة منطبقة حد النجاح الأدنى، كما يجب أن تحقق النتيجة "
"الموزونة حد النجاح الإجمالي. وتتجاوز الصيغة الخاصة بالمقرر صيغة كل المقررات "
"لذلك العرض."

