#: .\management_system\academic_access.py:152
#: .\management_system\academic_access.py:155
msgid "You do not have access to this offering."
msgstr "ليس لديك صلاحية الوصول إلى هذا المقرر."

msgid "This account cannot submit quizzes or save progress."
msgstr "لا يمكن لهذا الحساب إرسال الاختبارات أو حفظ التقدم."

#: .\management_system\academic_copy.py:12
msgid "Only administrators can copy academic offerings."
msgstr "يمكن للمسؤولين فقط نسخ المقررات الدراسية."

#: .\management_system\academic_copy.py:28 .\management_system\forms.py:553
msgid "Source and target academic scopes must be different."
msgstr "يجب أن يكون نطاق المصدر مختلفًا عن نطاق الهدف."

#: .\management_system\academic_copy.py:39
msgid "The selected academic scope no longer exists."
msgstr "النطاق الدراسي المحدد لم يعد موجودًا."

#: .\management_system\academic_copy.py:41
msgid "Offerings must be copied from an inactive academic year."
msgstr "يجب نسخ المقررات من سنة دراسية غير نشطة."

#: .\management_system\academic_copy.py:43
msgid "Offerings must be copied into the active academic year."
msgstr "يجب نسخ المقررات إلى السنة الدراسية النشطة."

#: .\management_system\academic_copy.py:45 .\management_system\forms.py:559
msgid "Source and target levels must match."
msgstr "يجب أن يتطابق مستوى المصدر والهدف."

#: .\management_system\academic_copy.py:47
msgid "Select at least one offering to copy."
msgstr "اختر مقررًا واحدًا على الأقل لنسخه."

#: .\management_system\academic_copy.py:57
msgid "One or more selected offerings do not belong to the source scope."
msgstr "مقرر واحد أو أكثر من المقررات المحددة لا ينتمي إلى نطاق المصدر."

#: .\management_system\academic_copy.py:59
msgid "A selected offering does not match the source scope level."
msgstr "أحد المقررات المحددة لا يطابق مستوى نطاق المصدر."

#: .\management_system\academic_copy.py:68
msgid "The target scope already contains one or more selected courses."
msgstr "يحتوي نطاق الهدف بالفعل على مقرر واحد أو أكثر من المقررات المحددة."

#: .\management_system\academic_enrollment.py:34
msgid "Only administrators can change academic enrollment state."
msgstr "يمكن للمسؤولين فقط تغيير حالة التسجيل الدراسي."

#: .\management_system\academic_enrollment.py:83
msgid "No course-level evaluation results exist for this student."
msgstr "لا توجد نتائج تقييم على مستوى المقرر لهذا الطالب."

#: .\management_system\academic_enrollment.py:89
msgid "Unevaluable courses must be resolved before promotion."
msgstr "يجب معالجة المقررات غير القابلة للتقييم قبل الترفيع."

#: .\management_system\academic_enrollment.py:114
#: .\management_system\academic_enrollment.py:569
#, python-format
msgid "Destination offerings are missing for failed course IDs: %(ids)s."
msgstr "عروض المقررات المقصودة مفقودة لمعرّفات المقررات الراسبة: %(ids)s."

#: .\management_system\academic_enrollment.py:127
msgid "Academic year does not exist."
msgstr "السنة الدراسية غير موجودة."

#: .\management_system\academic_enrollment.py:142
msgid "Invalid application status."
msgstr "حالة الطلب غير صالحة."

#: .\management_system\academic_enrollment.py:160
msgid "Exactly one active academic year is required before acceptance."
msgstr "يجب وجود سنة دراسية نشطة واحدة بالضبط قبل القبول."

#: .\management_system\academic_enrollment.py:169
msgid "The active academic year has no opened level."
msgstr "لا تحتوي السنة الدراسية النشطة على مستوى مفتوح."

#: .\management_system\academic_enrollment.py:186
msgid "The application already has an incompatible enrollment."
msgstr "للطلب تسجيل غير متوافق بالفعل."

#: .\management_system\academic_enrollment.py:228
msgid "The selected academic year is not active."
msgstr "السنة الدراسية المحددة غير نشطة."

#: .\management_system\academic_enrollment.py:249
msgid "The selected enrollment is not a normal full-year enrollment."
msgstr "القيد المحدد ليس قيدًا عاديًا للعام الدراسي بأكمله."

#: .\management_system\academic_enrollment.py:270
#| msgid "This evaluation result has already been promoted."
msgid "Only the aggregate evaluation result can be promoted."
msgstr "لا يمكن ترقية إلا نتيجة التقييم الإجمالية."

#: .\management_system\academic_enrollment.py:273
#| msgid "This evaluation result has already been promoted."
msgid "This evaluation result has already been processed."
msgstr "تمت معالجة نتيجة التقييم هذه بالفعل."

#: .\management_system\academic_enrollment.py:279
msgid "The evaluation formula and enrollment scopes do not match."
msgstr "لا تتطابق صيغة التقييم مع نطاقات التسجيل."

#: .\management_system\academic_enrollment.py:281
msgid ""
"An offering-specific formula cannot make an aggregate promotion decision."
msgstr "لا يمكن لصيغة خاصة بعرض مقرر اتخاذ قرار ترفيع إجمالي."

#: .\management_system\academic_enrollment.py:283
msgid "Only a normal enrollment can be promoted."
msgstr "يمكن ترقية التسجيل العادي فقط."

#: .\management_system\academic_enrollment.py:285
msgid "Only active or completed enrollments can be promoted."
msgstr "لا يمكن ترقية إلا التسجيلات النشطة أو المكتملة."

#: .\management_system\academic_enrollment.py:293
msgid "Activate a higher academic year before promotion."
msgstr "فعّل سنة دراسية أعلى قبل الترقية."

#: .\management_system\academic_enrollment.py:322
msgid "The destination academic level is not open in the active year."
msgstr "المستوى الدراسي المستهدف غير مفتوح في السنة النشطة."

#: .\management_system\academic_enrollment.py:335
msgid "A destination normal enrollment already exists for this student."
msgstr "يوجد تسجيل عادي مستهدف بالفعل لهذا الطالب."

#: .\management_system\academic_enrollment.py:357
#: .\management_system\historical_intake.py:338
#| msgid "An exceptional enrollment already exists for one selected offering."
msgid "Exceptional enrollment scope does not match its offering."
msgstr "لا يتطابق نطاق التسجيل الاستثنائي مع عرضه."

#: .\management_system\academic_enrollment.py:385
msgid "Select no more than 1,000 students at a time."
msgstr "اختر ١٬٠٠٠ طالب كحد أقصى في المرة الواحدة."

#: .\management_system\academic_enrollment.py:409
#: .\management_system\historical_intake.py:265
#| msgid "This evaluation result has already been promoted."
msgid "This historical summary has already been promoted."
msgstr "تمت ترقية هذا الملخص التاريخي بالفعل."

#: .\management_system\academic_enrollment.py:410
#: .\management_system\models.py:1251
msgid "A manual historical promotion requires a reason."
msgstr "الترقية التاريخية اليدوية تتطلب سببًا."

#: .\management_system\academic_enrollment.py:411
#: .\management_system\forms.py:424 .\management_system\forms.py:504
msgid "Review the historical outcome before promotion."
msgstr "راجع النتيجة التاريخية قبل الترقية."

#: .\management_system\academic_enrollment.py:416
#| msgid "The destination academic level is not open in the active year."
msgid "The destination academic year must be active."
msgstr "يجب أن تكون السنة الدراسية المستهدفة نشطة."

#: .\management_system\academic_enrollment.py:418
#| msgid "The destination academic level is not open in the active year."
msgid "The destination academic year must be later than the historical year."
msgstr "يجب أن تكون السنة الدراسية المستهدفة لاحقة للسنة التاريخية."

#: .\management_system\academic_enrollment.py:419
msgid "A reviewed historical outcome is required before promotion."
msgstr "يجب مراجعة النتيجة التاريخية قبل الترقية."

#: .\management_system\academic_enrollment.py:426
msgid "The historical source enrollment must be normal."
msgstr "يجب أن يكون تسجيل المصدر التاريخي عاديًا."

#: .\management_system\academic_enrollment.py:432
msgid "Exactly one active academic year is required for promotion."
msgstr "يلزم وجود سنة أكاديمية نشطة واحدة فقط لإجراء الترقية."

#: .\management_system\academic_enrollment.py:434
msgid "The destination must belong to the sole active academic year."
msgstr "يجب أن ينتمي الوجهة إلى السنة الأكاديمية النشطة الوحيدة."

#: .\management_system\academic_enrollment.py:432
msgid "Partial promotion requires at least one failed course."
msgstr "تتطلب الترقية الجزئية مقررًا راسبًا واحدًا على الأقل."

#: .\management_system\academic_enrollment.py:448
#| msgid "The selected enrollment is not a normal full-year enrollment."
msgid "The destination enrollment is not a normal enrollment."
msgstr "التسجيل المستهدف ليس تسجيلًا عاديًا."

#: .\management_system\academic_enrollment.py:449
msgid "The destination level does not match the historical promotion outcome."
msgstr "لا يتوافق المستوى الوجهة مع نتيجة الترقية التاريخية."

#: .\management_system\academic_enrollment.py:450
#| msgid "A destination normal enrollment already exists for this student."
msgid "The destination enrollment is withdrawn."
msgstr "تم سحب التسجيل المستهدف."

#: .\management_system\academic_enrollment.py:461
#| msgid "This enrollment type requires a course offering."
msgid "Last-level partial promotion requires failed course offerings."
msgstr "تتطلب الترقية الجزئية للمستوى الأخير عروض المقررات الراسبة."

#: .\management_system\academic_enrollment.py:463
msgid ""
"Every exceptional course must belong to the destination year and be "
"published."
msgstr "يجب أن ينتمي كل مقرر استثنائي إلى سنة الوجهة وأن يكون منشورًا."

#: .\management_system\academic_enrollment.py:477
msgid "An exceptional offering cannot use a normal enrollment."
msgstr "لا يمكن للعرض الاستثنائي استخدام تسجيل عادي."

#: .\management_system\academic_enrollment.py:497
msgid "Exceptional courses require a destination academic scope."
msgstr "تتطلب المقررات الاستثنائية نطاقًا أكاديميًا وجهة."

#: .\management_system\academic_enrollment.py:528
msgid ""
"The next academic year must open the last level before failed-course access "
"can be created."
msgstr ""
"يجب أن تفتح السنة الأكاديمية التالية المستوى الأخير قبل إنشاء وصول للمقررات "
"الراسبة."

#: .\management_system\academic_evaluation.py:108
#, python-format
msgid ""
"Quiz %(name)s declares %(declared)s points but its questions total "
"%(actual)s."
msgstr ""
"يعلن الاختبار %(name)s عن %(declared)s نقطة، بينما مجموع أسئلته %(actual)s."

#: .\management_system\academic_evaluation.py:124
#| msgid "Course offering is required for scheduled upload"
msgid "A course offering is required to build a course evaluation plan."
msgstr "يلزم اختيار عرض مقرر لإنشاء خطة تقييم المقرر."

#: .\management_system\academic_evaluation.py:254
#, python-format
msgid ""
"%(count)d unresolved manual-grade question(s), excluding %(points)d point(s)."
msgstr ""
"تم استبعاد %(count)d سؤالًا غير محسوم التصحيح اليدوي، بإجمالي %(points)d نقطة."

#: .\management_system\academic_evaluation.py:259
msgid "This course has no published lectures."
msgstr "لا توجد محاضرات منشورة لهذا المقرر."

#: .\management_system\academic_evaluation.py:458
#| msgid "No attendance course is available for this student today."
msgid "No published course offerings are available for this formula."
msgstr "لا توجد عروض مقررات منشورة متاحة لهذه الصيغة."

#: .\management_system\academic_evaluation.py:556
msgid "Only administrators can override evaluation results."
msgstr "يمكن للمسؤولين فقط تعديل نتائج التقييم."

#: .\management_system\academic_evaluation.py:558
msgid "Invalid evaluation status."
msgstr "حالة التقييم غير صالحة."

#: .\management_system\academic_evaluation.py:561
msgid "A promoted result is immutable and cannot be overridden."
msgstr "نتيجة الترقية غير قابلة للتغيير ولا يمكن تعديلها."

#: .\management_system\academic_formula.py:16
msgid "Only administrators can manage promotion formulas."
msgstr "يمكن للمسؤولين فقط إدارة صيغ الترقية."

#: .\management_system\academic_formula.py:22
msgid "Add at least one promotion rule."
msgstr "أضف قاعدة ترقية واحدة على الأقل."

#: .\management_system\academic_formula.py:29
msgid "Enter a weight for every rule when there is more than one rule."
msgstr "أدخل وزنًا لكل قاعدة عند وجود أكثر من قاعدة."

#: .\management_system\academic_formula.py:50
msgid "Rule percentages must be valid numbers."
msgstr "يجب أن تكون نسب القواعد أرقامًا صالحة."

#: .\management_system\academic_formula.py:52
msgid "Rule percentages must be between 0 and 100."
msgstr "يجب أن تتراوح نسب القواعد بين 0 و100."

#: .\management_system\academic_formula.py:56 .\management_system\forms.py:666
#: .\management_system\models.py:1049
msgid "Attendance rules cannot select a quiz type."
msgstr "لا يمكن لقواعد الحضور اختيار نوع اختبار."

#: .\management_system\academic_formula.py:61
msgid "A quiz type cannot appear in more than one rule."
msgstr "لا يمكن أن يظهر نوع الاختبار في أكثر من قاعدة واحدة."

#: .\management_system\academic_formula.py:65
msgid "Select a valid promotion rule metric."
msgstr "اختر مقياسًا صالحًا لقاعدة الترقية."

#: .\management_system\academic_formula.py:69
msgid "Only one attendance rule is allowed."
msgstr "يُسمح بقاعدة حضور واحدة فقط."

#: .\management_system\academic_formula.py:71
msgid "All-quizzes and specific quiz-type rules cannot overlap."
msgstr ""
"لا يمكن أن تتداخل قاعدة كل الاختبارات مع قواعد أنواع الاختبارات المحددة."

#: .\management_system\academic_formula.py:73
msgid "Rule weights must total exactly 100 percent."
msgstr "يجب أن يساوي مجموع أوزان القواعد 100٪ بالضبط."

#: .\management_system\academic_formula.py:90
msgid "Promotion formulas can only be saved for the active academic year."
msgstr "لا يمكن حفظ صيغ الترقية إلا للسنة الدراسية النشطة."

#: .\management_system\academic_formula.py:92 .\management_system\forms.py:623
#: .\management_system\models.py:751 .\management_system\models.py:988
#| msgid "Course offering must belong to the enrollment scope."
msgid "Course offering must belong to the selected academic scope."
msgstr "يجب أن ينتمي عرض المقرر إلى النطاق الدراسي المحدد."

#: .\management_system\academic_formula.py:94
msgid "Overall passing threshold must be between 0 and 100."
msgstr "يجب أن تتراوح نسبة النجاح الإجمالية بين 0 و100."

#: .\management_system\academic_formula.py:96 .\management_system\models.py:985
#| msgid "Overall passing threshold must be between 0 and 100."
msgid "The repeat threshold must be at least 1."
msgstr "يجب ألا يقل حد إعادة المستوى عن 1."

#: .\management_system\academic_formula.py:99 .\management_system\forms.py:627
#: .\management_system\models.py:992
#| msgid "End date must be after start date."
msgid "Evaluation end date must not be before the start date."
msgstr "يجب ألا يسبق تاريخ انتهاء التقييم تاريخ بدايته."

#: .\management_system\academic_formula.py:101 .\management_system\forms.py:629
#: .\management_system\models.py:994
#| msgid "Evaluation date must be inside the academic year."
msgid "Evaluation start date must be inside the academic year."
msgstr "يجب أن يقع تاريخ بدء التقييم داخل السنة الدراسية."

#: .\management_system\academic_formula.py:103
#| msgid "Evaluation date must be inside the academic year."
msgid ""
"Evaluation end date must be inside the academic year and cannot be in the "
"future."
msgstr "يجب أن يقع تاريخ انتهاء التقييم داخل السنة الدراسية وألا يكون في المستقبل."

