# Django
DJANGO_SECRET_KEY=insecure_dev_key_replace_me
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=Africa/Cairo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For production, use: https://example.com,https://*.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8082,http://127.0.0.1:8080,http://127.0.0.1:8082
DJANGO_SITE_DOMAIN=http://localhost:8000
# Server-only media automation boundary. Keep the key in the deployment secret
# store. The server resolves its existing content-manager account from Django.
AUTOMATION_API_KEY=
# Local browser/API development. Set DJANGO_ALLOW_LOCALHOST_ORIGINS=false in
# production and list deployed browser origins explicitly below.
DJANGO_ALLOW_LOCALHOST_ORIGINS=true
DJANGO_LOCALHOST_PORTS=3000,4173,5173,8000,8080,8081,8082,8443
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
# Optional dedicated pgcrypto passphrase for Telegram token/webhook-secret
# ciphertext. If blank, Django's SECRET_KEY is used as the encryption key.
# The Telegram bot token and webhook secret are NOT environment variables:
# they are configured in the admin dashboard and stored encrypted in the
# database only. setup_env.sh prompts for this key with a hidden input and
# never writes or generates the bot credentials.
TELEGRAM_ENCRYPTION_KEY=
# Deployment sets this automatically to a unique release value.
STATIC_ASSET_VERSION=dev

# PostgreSQL is the canonical application database. SQLite is exposed only as
# the controlled `sqlite_source` import alias.

# -- PostgreSQL (Docker) --------------------------------------
# Used by compose.infrastructure.yml and compose.application.yml.
# These are development-only placeholders - change the password before any
# deployment that is accessible beyond localhost.
POSTGRES_DB=lms_database
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SQLITE_SOURCE_PATH=/app/db.sqlite3

# -- Celery / Redis (broker & result backend) ---------------------
# Default to the redis service on the lms_network at port 6379 db 0.
# Both CELERY_BROKER_URL and CELERY_RESULT_BACKEND fall back to REDIS_URL
# when set, otherwise to the static default below.
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_CONCURRENCY=2

# -- Expo Push Service (server-side mobile delivery) -------------
# Set this only in the server's ignored .env. Never expose it to the mobile
# app, templates, logs, or API responses. Create it at
# https://expo.dev/settings/access-tokens after enabling Expo push security.
# Leave blank until migrations 0063-0069 and the mobile push worker are ready.
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_SEND_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
EXPO_PUSH_TIMEOUT_SECONDS=15
# Five requests/second x 100 messages/request = 500 messages/second, below
# Expo's documented 600 notifications/second ceiling.
EXPO_PUSH_REQUESTS_PER_SECOND=5
# Lesson-publication push notifications expire after this many seconds.
# Quiz-opening notifications expire at their effective closing time.
MOBILE_PUSH_LESSON_TTL_SECONDS=86400

# -- Server-side media processing (dedicated FFmpeg worker) ------
# Native FFmpeg media processing runs only inside the dedicated `media-worker`
# Celery service on the `media` queue (concurrency 1, prefetch 1). Production
# runs this worker on a separate host (proposal decision D6); local disposable
# rehearsal may run it on the existing network.
# FFPROBE_BINARY is also present in the web/general runtime image because
# support-chat audio uploads are duration-checked synchronously in the web
# process. It does not run the media pipeline.
# MEDIA_WORK_DIR is a private processing volume mounted only into media-worker,
# separate from static files and R2 data.
MEDIA_WORK_DIR=/var/lib/lms-media-processing
FFPROBE_BINARY=ffprobe
# Maximum accepted source file size in bytes (2 GiB).
MEDIA_MAX_SOURCE_SIZE=2147483648
# Maximum accepted source duration in seconds (3 hours).
MEDIA_MAX_DURATION_SECONDS=10800
# Per-job FFmpeg soft/hard timeout in seconds (2 hours).
MEDIA_JOB_TIMEOUT_SECONDS=7200
# Signed playback capability lifetime. The viewing-session token and the
# per-segment manifest tokens are minted for this long; the player still renews
# proactively at 80% of the segment-token window so expiry never interrupts
# playback.
MEDIA_VIEWING_SESSION_HOURS=3
MEDIA_SEGMENT_TOKEN_MINUTES=180
# HLS segment duration in seconds for media processing. Keep this aligned with
# MEDIA_VIDEO_MAXRATE so every generated .ts segment stays under
# MEDIA_MAX_SEGMENT_BYTES: worst case is about
# (MEDIA_VIDEO_MAXRATE + MEDIA_AUDIO_BITRATE) x MEDIA_SEGMENT_SECONDS plus one
# bufsize burst window.
MEDIA_SEGMENT_SECONDS=6
# Retention of queued/retryable staging sources in hours (24).
MEDIA_SOURCE_RETENTION_HOURS=24
# Retention of failed-job staging sources in hours. Proposal decision D5:
# failed staging sources are kept 72 hours, while successful job records are
# retained 90 days (database-level cleanup, not controlled by this value).
MEDIA_FAILED_SOURCE_RETENTION_HOURS=72
# Successful job rows may be purged after this database retention period.
MEDIA_SUCCESSFUL_JOB_RETENTION_DAYS=90
# Initial media-worker concurrency (1 = one FFmpeg job at a time).
MEDIA_WORKER_CONCURRENCY=1
# Video quality target for the always-compressed HLS video output (x264 CRF,
# 0-51; lower = higher quality and larger files). 23 is the x264 default and
# visually close to the source. The rate window below caps the size of CRF.
MEDIA_VIDEO_CRF=23
# x264 preset for the video encode: ultrafast|superfast|veryfast|faster|fast|
# medium|slow|slower|veryslow. Slower presets compress more but take longer.
MEDIA_VIDEO_PRESET=fast
# Capped-CRF rate window: maxrate is the sustained video bitrate and bufsize is
# the one-second burst window. Keep bufsize <= maxrate so a segment cannot grow
# beyond the size guarantee.
MEDIA_VIDEO_MAXRATE=448k
MEDIA_VIDEO_BUFSIZE=448k
# Long side of the video is downscaled to this width (0 disables scaling).
MEDIA_VIDEO_MAX_WIDTH=854
# AAC-LC bitrate for the extracted audio HLS and the muxed video audio. 96k
# stereo is transparent for speech and good for music; mono sources are encoded
# at MEDIA_AUDIO_MONO_BITRATE for the same perceived quality with fewer bytes.
MEDIA_AUDIO_BITRATE=96k
MEDIA_AUDIO_MONO_BITRATE=64k
# Downloadable MP3 bitrate (MP3 is less efficient than AAC, so it keeps 128k).
MEDIA_MP3_BITRATE=128k
# Worker-side per-segment size target in bytes. Oversized output triggers
# shorter-segment/lower-rate retries; a final best-effort output is accepted
# with a warning so a valid uploaded source is never rejected only for this
# advisory target. 0 disables the size check.
MEDIA_MAX_SEGMENT_BYTES=512000

# -- Gunicorn (production WSGI) ----------------------------------
# Worker model: gthread with N workers x M threads.
# For 500 concurrent students on 4 vCPU, 2 workers x 8 threads is a sane
# starting point; adjust WEB_CONCURRENCY and WEB_THREADS per load testing.
# GUNICORN_TIMEOUT covers long-running upload/response requests (default 1800s / 30 minutes).
WEB_CONCURRENCY=2
WEB_THREADS=8
GUNICORN_TIMEOUT=1800
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=2147483648
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# -- Docker ---------------------------------------------------
# setup_env.sh generates .compose.env from the non-secret settings below.
# Use .compose.env with Docker Compose; .env is passed to containers as a
# raw service env_file so literal '$' characters in secrets are preserved.
# Nginx HTTP port (redirect-only in production; use 80 behind a firewall that
# terminates ACME or with a separate certbot container). Default is 8080 for
# local development to avoid port conflicts.
NGINX_HTTP_PORT=8080
# Nginx HTTPS port - set to 443 on the production server.
NGINX_HTTPS_PORT=443
# Directory containing fullchain.pem and privkey.pem. On a production server
# with Let's Encrypt, point this to the live domain directory, e.g.:
# NGINX_TLS_CERT_DIR=/etc/letsencrypt/live/bibleinstitute-eg.org
# Certificates must be provisioned separately and kept valid. The directory
# is mounted read-only into the nginx container; never copy keys into images.
NGINX_TLS_CERT_DIR=./certs
# Runtime state used by Nginx and the blue/green deployment scripts. Keep this
# outside the Git checkout on a server; the relative default is convenient for
# local disposable launches.
LMS_RUNTIME_DIR=./runtime
# Exact HTTPS host for the read-only Dozzle viewer. setup_env.sh derives this
# as monitor.<primary-domain>; do not expose Dozzle under a path on the primary
# application domain.
# The TLS certificate must cover this host as well as the primary domain.
MONITORING_DOMAIN=monitor.example.com
DEPLOY_HEALTHCHECK_URL=https://bibleinstitute-eg.org/
STOP_OLD_SLOT=False

# Email (Gmail SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_TIMEOUT=20
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=noreply@bibleinstitute.edu
DJANGO_ADMIN_EMAIL=

# -- Cloudflare R2 (Django S3-compatible client) --------------
# Django's boto3 S3 client uses these credentials to read/write R2.
# R2_ENDPOINT_URL format: https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are the S3-compatible access
# credentials from your R2 bucket -> "Manage R2 API Tokens".
# These are NOT the same as CLOUDFLARE_API_TOKEN below.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lecture-storage
# Dedicated private bucket for Telegram support attachments; never reuse the
# academic media bucket above.
TELEGRAM_R2_BUCKET_NAME=
# -- Graduation gallery (cached signed R2 URLs) -------------------
# Gallery bytes stay private in R2_BUCKET_NAME under the unguessable
# galleries/ prefix. Readers get signed GET URLs (ResponseCacheControl
# public, max-age, immutable) that Django reuses from cache until shortly
# before expiry, so Cloudflare and browsers can cache them. The album listing
# itself stays authenticated + graduation-checked.
# GALLERY_URL_EXPIRES_SECONDS=21600
# GALLERY_R2_PUBLIC_CACHE_MAX_AGE=31536000

# -- Cloudflare R2 Management API (optional, Django-side) -----
# Only needed for Django's R2 management/API operations (bucket admin).
# Not required by the media Worker or by local playback.
# Get these from the Cloudflare dashboard (Account ID, API Tokens page).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# -- Cloudflare Worker Integration (Django-side) --------------
# CLOUD_WORKER is the public HTTPS URL of the deployed Worker that proxies
# HLS segments. Django rewrites manifest URIs to point here.
# WORKER_HMAC_SECRET must be exactly the same value as the Worker's HMAC_SECRET.
# WORKER_RECEIPT_SECRET must be exactly the same value as the Worker's
# DJANGO_RECEIPT_SECRET. Django and the Worker share these two secrets.
CLOUD_WORKER=
WORKER_HMAC_SECRET=
WORKER_RECEIPT_SECRET=

# -- Cloudflare Worker Configuration (set in Cloudflare dashboard / wrangler.toml) --
# These are NOT Django environment variables. They are Worker bindings or
# secrets configured in the Cloudflare dashboard or wrangler.toml.
#   MY_BUCKET              = R2 bucket binding (must match R2_BUCKET_NAME)
#   HMAC_SECRET            = same value as Django WORKER_HMAC_SECRET
#   DJANGO_RECEIPT_URL     = https://bibleinstitute-eg.org/en/api/worker/receipt/
#   DJANGO_RECEIPT_SECRET  = same value as Django WORKER_RECEIPT_SECRET
#   ALLOWED_DOMAIN         = bibleinstitute-eg.org (or a comma-separated list
#                              including an exact temporary ngrok hostname)

# -- Dozzle live Docker log viewer (infrastructure) -------------
# Lightweight read-only container log viewer served by Nginx at the dedicated
# host https://monitor.<site-domain>/ (no Portainer-style management UI).
# Dozzle is live log viewing only: it does not retain or index historical
# logs, so it is not an offline log-search/retention database.
# Host directory bind-mounted into the dozzle container at /data. The
# simple-auth users file ($DOZZLE_DATA_DIR/users.yml) is generated OUTSIDE
# Git by the monitoring setup script (`dozzle generate`); the directory is
# created mode 700 and the file mode 600. Never commit a password or hash,
# and do not start Dozzle before that file exists.
DOZZLE_DATA_DIR=./runtime/dozzle
# Dozzle is served from the root of MONITORING_DOMAIN. There is no public
# Dozzle path on the primary application domain.
DOZZLE_LOG_PATH=/

# Configuration precedence
# ------------------------
# 1. A real process environment variable always wins.
# 2. .env values load through python-dotenv and do not override the process
#    environment.
# 3. settings.py defaults apply last (POSTGRES_HOST=localhost,
#    POSTGRES_DB=lms_database, POSTGRES_USER=lms_user, POSTGRES_PORT=5432).
# Compose reads the same .env for container configuration, so keep one
# definition per key and do not repeat DB/host/thread keys.

# Secret rotation policy
# ----------------------
# WORKER_HMAC_SECRET, WORKER_RECEIPT_SECRET and TELEGRAM_ENCRYPTION_KEY fall
# back to DJANGO_SECRET_KEY when unset. Rotating those values independently
# changes how existing receipts or Telegram ciphertext decrypt, so it is a
# separate migration/rollout and is not part of routine cleanup. Never print
# or commit resolved values.

# Trusted ingress identity
# ------------------------
# Only these peer networks may supply the canonical X-Client-IP header. Nginx
# is the single internal hop and rewrites the header from the validated
# Cloudflare/direct client address. The setup script creates lms_network with
# this subnet; change both together if the subnet is customised. Leaving the
# value empty keeps the request socket address (safe direct development).
DJANGO_TRUSTED_PROXY_IPS=172.31.240.0/24
